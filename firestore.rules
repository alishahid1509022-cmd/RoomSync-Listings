rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────
    // listings collection
    // ────────────────────────────────────────────
    match /listings/{listingId} {

      // Anyone can read listings (matches our "browsing is public" design)
      allow read: if true;

      // Only signed-in users can create, AND the createdBy.uid must match their own uid
      // (prevents a malicious user from creating listings as someone else)
      allow create: if request.auth != null
                    && request.resource.data.createdBy.uid == request.auth.uid;

      // Only the original creator can update or delete their listing
      allow update, delete: if request.auth != null
                            && resource.data.createdBy.uid == request.auth.uid;
    }

    // ────────────────────────────────────────────
    // users collection
    // ────────────────────────────────────────────
    match /users/{userId} {

      // Any signed-in user can read profiles (needed for chat user list + conversation headers)
      allow read: if request.auth != null;

      // Users can only write their own document
      allow create, update: if request.auth != null
                            && request.auth.uid == userId;
    }

    // ────────────────────────────────────────────
    // chats collection
    // ────────────────────────────────────────────
    match /chats/{chatId} {

      // Any signed-in user can read — needed so ensureChatExists can call
      // getDoc on a chat that may not exist yet (non-existent doc reads must
      // be allowed or Firestore returns permission-denied before we can check).
      allow read: if request.auth != null;

      // Only the initiating user (who must be a participant) can create
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;

      // Only participants can update (e.g. lastMessage preview)
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {

        // Any participant in the parent chat can read messages
        allow read: if request.auth != null;

        // Only send as yourself
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}